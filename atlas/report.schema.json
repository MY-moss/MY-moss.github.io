{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-moss.github.io/atlas/report.schema.json",
  "type": "object",
  "required": [
    "channel",
    "date",
    "title",
    "summary",
    "items"
  ],
  "properties": {
    "channel": {
      "enum": [
        "world",
        "reading",
        "opensource",
        "inspiration"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "week": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source",
          "why",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "repo_url": {
            "type": "string",
            "format": "uri"
          },
          "website_url": {
            "type": "string",
            "format": "uri"
          },
          "docs_url": {
            "type": "string",
            "format": "uri"
          },
          "author": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "uses": {
            "type": "string"
          },
          "use_cases": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "stack": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "tech_stack": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "maturity": {
            "type": "string"
          },
          "difficulty": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "risks": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "project_fit": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "stars": {
            "type": [
              "string",
              "number",
              "integer"
            ]
          },
          "platforms": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "platform_support": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "published": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "minutes": {
            "type": "integer"
          },
          "reading_minutes": {
            "type": "integer"
          },
          "access": {
            "enum": [
              "free",
              "paid",
              "unknown"
            ]
          }
        },
        "additionalProperties": true,
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "repo_url"
            ]
          },
          {
            "required": [
              "website_url"
            ]
          }
        ]
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "itemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "inspiration"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "creator",
                "method",
                "uses"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "world"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "summary",
                "confidence"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "reading"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "author",
                "published_at",
                "reading_minutes",
                "access"
              ],
              "properties": {
                "published_at": {
                  "type": "string",
                  "format": "date"
                },
                "reading_minutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "access": {
                  "enum": [
                    "free",
                    "paid",
                    "unknown"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "opensource"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "stack",
                "maturity",
                "difficulty",
                "risks",
                "recommendation",
                "license",
                "uses",
                "project_fit",
                "version",
                "stars",
                "platforms"
              ]
            }
          }
        }
      }
    }
  ]
}
